---
import Base from '../layouts/Base.astro';
import { screens, getScreen } from '../data/screens';

export function getStaticPaths() {
  // every screen except home (home has its own index.astro)
  return screens.filter((s) => s.path !== '').map((s) => ({ params: { path: s.path } }));
}

const { path } = Astro.params;
const screen = getScreen(path || '');
if (!screen) return Astro.redirect('/');
---
<Base title={screen.title} activePath={screen.path}>
  <main class="fl-stage">
    <iframe class="screen screen-mobile active" src={`/stitch-screens/${screen.mobile}.html`} title={`${screen.nav} mobile`} loading="lazy"></iframe>
    <iframe class="screen screen-desktop" src={`/stitch-screens/${screen.desktop}.html`} title={`${screen.nav} desktop`} loading="lazy"></iframe>
  </main>
</Base>
