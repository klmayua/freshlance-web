---
import Base from '../layouts/Base.astro';
import { screenContent } from '../lib/stitch';
import { screens, getScreen } from '../data/screens';

export function getStaticPaths() {
  return screens.filter((s) => s.path !== '').map((s) => ({ params: { path: s.path } }));
}

const { path } = Astro.params;
const screen = getScreen(path || '');
if (!screen) return Astro.redirect('/');

const mobile = screenContent(screen.mobile);
const desktop = screenContent(screen.desktop);
---
<Base title={screen.title} activePath={screen.path}>
  <div class="fl-page">
    <div class="device-mobile" set:html={mobile}></div>
    <div class="device-desktop" set:html={desktop}></div>
  </div>
</Base>
