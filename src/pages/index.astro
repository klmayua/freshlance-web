---
import Base from '../layouts/Base.astro';
import { screenBody } from '../lib/stitch';
import { screens } from '../data/screens';

const home = screens[0];
const mobile = screenBody(home.mobile);
const desktop = screenBody(home.desktop);
---
<Base title={home.title}>
  <div class="device-mobile" set:html={mobile}></div>
  <div class="device-desktop" set:html={desktop}></div>
</Base>
