---
import Base from '../layouts/Base.astro';
import { screenContent } from '../lib/stitch';
import { screens } from '../data/screens';

const sections = screens.map((s) => ({
  ...s,
  mobile: screenContent(s.mobile),
  desktop: screenContent(s.desktop),
}));
---
<Base>
  <div class="fl-page">
    {sections.map((sec) => (
      <section id={sec.id} class="fl-section">
        <div class="device-mobile" set:html={sec.mobile}></div>
        <div class="device-desktop" set:html={sec.desktop}></div>
      </section>
    ))}
  </div>
</Base>
