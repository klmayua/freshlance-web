---
import '../styles/global.css';
import { screenConfig } from '../lib/stitch';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Freshlance — Innovative Healthcare',
  description = 'Freshlance delivers high-touch, innovative healthcare across Nigeria — specialized care, medical equipment & consulting, and consultation services.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b6d24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Freshlance" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline set:html={screenConfig()}></script>
    <style is:inline>
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .icon-filled { font-variation-settings: 'FILL' 1; }
    </style>
  </head>
  <body class="fl-app">
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
      // Rewire each Stitch screen's own nav (href="#") to the real routes.
      (function () {
        const NAV = {
          'home': '/',
          'freshlance': '/',
          'freshlance nigeria': '/',
          'freshlance nigeria home': '/',
          'care': '/specialized-care',
          'specialized care': '/specialized-care',
          'specialised care': '/specialized-care',
          'solutions': '/equipment-consulting',
          'equipment': '/equipment-consulting',
          'medical equipment': '/equipment-consulting',
          'about': '/consultation-contact',
          'contact': '/consultation-contact',
          'contact us': '/consultation-contact',
          'book inquiry': '/consultation-contact',
          'book a consult': '/consultation-contact',
          'request an inquiry': '/consultation-contact',
          'explore services': '/specialized-care'
        };
        const norm = (s) => s.trim().toLowerCase().replace(/\s+/g, ' ');
        document.querySelectorAll('a').forEach((a) => {
          const href = a.getAttribute('href') || '';
          if (!href.startsWith('#')) return;
          let key = norm(a.textContent);
          if (!NAV[key]) {
            const al = a.getAttribute('aria-label');
            if (al) key = norm(al);
          }
          const route = NAV[key];
          if (route) a.setAttribute('href', route);
        });
      })();
    </script>
  </body>
</html>
