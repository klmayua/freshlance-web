---
import '../styles/global.css';
import { screenConfig } from '../lib/stitch';
import { screens } from '../data/screens';

interface Props {
  title?: string;
  description?: string;
  activePath?: string; // '' for home
}
const {
  title = 'Freshlance — Innovative Healthcare',
  description = 'Freshlance delivers high-touch, innovative healthcare across Nigeria — specialized care, medical equipment & consulting, and consultation services.',
  activePath = '',
} = Astro.props;

const ICONS = {
  '': 'home',
  'specialized-care': 'medical_services',
  'equipment-consulting': 'precision_manufacturing',
  'consultation-contact': 'contact_mail',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b6d24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Freshlance" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline set:html={screenConfig()}></script>
    <style is:inline>
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .icon-filled { font-variation-settings: 'FILL' 1; }
    </style>
  </head>
  <body class="fl-app">
    <!-- UNIFORM premium top nav (desktop) -->
    <nav class="fl-nav">
      <a class="brand" href="/">
        <img src="/logo.png" alt="Freshlance" />
        <span>Freshlance</span>
      </a>
      <div class="links">
        {screens.map((s) => (
          <a href={s.path ? `/${s.path}` : '/'} class={s.path === activePath ? 'active' : ''}>{s.nav}</a>
        ))}
        <a class="cta" href="/consultation-contact">Book a Consult</a>
      </div>
    </nav>

    <slot />

    <!-- UNIFORM premium bottom nav (mobile) -->
    <nav class="fl-bottom">
      {screens.map((s) => (
        <a href={s.path ? `/${s.path}` : '/'} class={s.path === activePath ? 'active' : ''}>
          <span class="material-symbols-outlined">{ICONS[s.path] || 'home'}</span>
          <span>{s.nav}</span>
        </a>
      ))}
    </nav>

    <!-- UNIFORM premium footer -->
    <footer class="fl-foot">
      <div class="inner">
        <div class="brand">
          <img src="/logo.png" alt="Freshlance" />
          <p>Pioneering high-touch healthcare through precision pharmaceuticals and holistic medical consulting across Nigeria.</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            <li><a href="/specialized-care">Specialized Care</a></li>
            <li><a href="/equipment-consulting">Equipment &amp; Consulting</a></li>
            <li><a href="/consultation-contact">Consultation</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/consultation-contact">Contact</a></li>
            <li><a href="/consultation-contact">Book Inquiry</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="/consultation-contact">Privacy Policy</a></li>
            <li><a href="/consultation-contact">Regulatory</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">© 2024 Freshlance Nigeria. Regulated by PCN. All rights reserved.</div>
    </footer>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
