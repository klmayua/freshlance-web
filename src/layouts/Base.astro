---
import '../styles/global.css';
import { screenConfig } from '../lib/stitch';
import { screens } from '../data/screens';
import { House, Stethoscope, Factory, MailOpen, CalendarCheck } from '@lucide/astro';

// Map Stitch section id -> Lucide Astro component (Astro-native icons)
const navIcons: Record<string, any> = {
  home: House,
  care: Stethoscope,
  equipment: Factory,
  contact: MailOpen,
};
const CtaIcon = CalendarCheck;

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Freshlance — Innovative Healthcare',
  description = 'Freshlance delivers high-touch, innovative healthcare across Nigeria — specialized care, medical equipment & consulting, and consultation services.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b6d24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Freshlance" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline set:html={screenConfig()}></script>
    <style is:inline>
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
      .icon-filled { font-variation-settings: 'FILL' 1; }
    </style>
  </head>
  <body class="fl-app">
    <!-- UNIFORM premium top nav (DESKTOP only) -->
    <nav class="fl-nav">
      <div class="links">
        {screens.map((s) => {
          const IconComp = navIcons[s.id];
          return (
            <a href={`#${s.id}`} data-spy={s.id}>
              <IconComp size={18} strokeWidth={2} />
              <span>{s.nav}</span>
            </a>
          );
        })}
      </div>
      <a class="brand" href="#home">
        <img src="/logo.png" alt="Freshlance" />
      </a>
      <a class="cta" href="#contact">
        <CtaIcon size={18} strokeWidth={2} />
        <span>Book a Consult</span>
      </a>
    </nav>

    <slot />

    <!-- UNIFORM premium bottom nav (MOBILE only) -->
    <nav class="fl-bottom">
      {screens.map((s) => {
        const IconComp = navIcons[s.id];
        return (
          <a href={`#${s.id}`} data-spy={s.id}>
            <IconComp size={22} strokeWidth={2} />
            <span>{s.nav}</span>
          </a>
        );
      })}
    </nav>

    <!-- UNIFORM premium footer -->
    <footer class="fl-foot">
      <div class="inner">
        <div class="brand">
          <img src="/logo-light.png" alt="Freshlance" />
          <p>Pioneering high-touch healthcare through precision pharmaceuticals and holistic medical consulting across Nigeria.</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            <li><a href="#care">Specialized Care</a></li>
            <li><a href="#equipment">Equipment &amp; Consulting</a></li>
            <li><a href="#contact">Consultation</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="#contact">Book Inquiry</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="#contact">Privacy Policy</a></li>
            <li><a href="#contact">Regulatory</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">© 2024 Freshlance Nigeria. Regulated by PCN. All rights reserved.</div>
    </footer>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
    <script>
      import { animate, inView, stagger } from 'motion';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Nav entrance (quiet fade-down) + CTA
      if (!reduce) {
        const nav = document.querySelector('.fl-nav');
        if (nav) animate(nav, { opacity: [0, 1], y: [-12, 0] }, { duration: 0.5, easing: [0.16, 1, 0.3, 1] });
      }

      // 2) Scroll-spy: highlight the active section link (top + bottom nav)
      const sections = screensData();
      const byId = (id) => document.getElementById(id);
      const setActive = (id) => {
        document.querySelectorAll('[data-spy]').forEach((el) => {
          el.classList.toggle('active', el.getAttribute('data-spy') === id);
          if (el.getAttribute('data-spy') === id) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
      };
      // default: first section active on load
      setActive('home');
      if ('IntersectionObserver' in window && sections.length) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(e.target.id);
          });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
        sections.forEach((s) => { const el = byId(s.id); if (el) obs.observe(el); });
      }

      // 3) Bottom-nav tap pop + instant active on tap (so the tap feels responsive)
      document.querySelectorAll('.fl-bottom a').forEach((a) => {
        a.addEventListener('click', () => {
          setActive(a.getAttribute('data-spy'));
          a.classList.remove('pop');
          void a.offsetWidth; // reflow to restart animation
          a.classList.add('pop');
        });
      });

      // 4) Scroll reveal on Stitch sections (staggered children if present)
      if (!reduce) {
        document.querySelectorAll('.fl-section').forEach((sec) => {
          inView(sec, ({ target }) => {
            const kids = target.querySelectorAll('.fl-reveal');
            const targets = kids.length ? kids : [target];
            animate(targets, { opacity: [0, 1], y: [24, 0] },
              { duration: 0.55, easing: [0.16, 1, 0.3, 1], delay: stagger(0.08) });
          }, { amount: 0.15 });
        });
      }

      function screensData() {
        // mirrors src/data/screens.ts ids
        return [
          { id: 'home' }, { id: 'care' }, { id: 'equipment' }, { id: 'contact' }
        ];
      }
    </script>
  </body>
</html>
